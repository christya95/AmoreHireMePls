# Non-secret configuration. Copy to .env on the machine running the service.
# Secrets are injected at runtime (op run --env-file .env.references -- ...). Leave them blank here.

# --- MongoDB -------------------------------------------------------------
# NAS: the app joins the existing private database network and uses mongodb://mongodb:27017.
# Mac dev: compose profile dev-mongo publishes 127.0.0.1:27027.
# Dev container: mongodb://127.0.0.1:27027. NAS over Tailscale: mongodb://100.90.96.81:27017/?directConnection=true
# (inside NAS containers: mongodb://host.docker.internal:27017/?directConnection=true)
AMORE_MONGODB_URI=mongodb://127.0.0.1:27027
AMORE_MONGODB_DATABASE=amorehiremepls
AMORE_MONGODB_USERNAME=
AMORE_MONGODB_PASSWORD=
# NAS app user amorehiremepls_app authenticates against its own database: set amorehiremepls
AMORE_MONGODB_AUTH_SOURCE=admin

# --- Web -----------------------------------------------------------------
AMORE_BIND_HOST=127.0.0.1
AMORE_PORT=8790
# Dashboard sign-in password (>= 12 chars) and cookie signing secret (>= 32 chars). Store in 1Password.
AMORE_APP_PASSWORD=
AMORE_APP_SECRET=
AMORE_SECURE_COOKIES=false
# IANA zone for schedules and the dates shown in the dashboard (Europe/London, America/Vancouver, ...). Default UTC.
AMORE_TIMEZONE=UTC

# --- Storage -------------------------------------------------------------
# Artifacts (resumes, receipts, snapshots) and private profile files. Mounted volume in Docker.
AMORE_ARTIFACT_DIR=./runtime/artifacts
AMORE_PRIVATE_DIR=./runtime/private
AMORE_LOG_DIR=./runtime/logs
# Your folder: profile.toml (who you are, what you want, what to skip; start from profile.example.toml), one base
# resume .docx and extra career notes (.md/.txt/.docx). Only the README and the fictional example are in git.
AMORE_CANDIDATE_DIR=./candidate
# How much of the extra notes' text is used (characters, files in name order, cut at the limit; max 60000).
# The code default is 12000; raise it when your notes are long and your model budget allows.
AMORE_CANDIDATE_SUPPLEMENTAL_MAX_CHARS=12000

# --- AI providers (optional; without a key the app runs deterministic paths only) ---------
# Default provider is OpenAI. AMORE_MODEL may be a bare model name (uses AMORE_MODEL_PROVIDER) or
# fully qualified, e.g. anthropic:claude-... to use Anthropic for a run.
AMORE_MODEL_PROVIDER=openai
AMORE_MODEL=
# Keys are injected at runtime from 1Password (config/op.env.example); never store them here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Dated pricing file (USD per 1M tokens). Unknown models record cost as unknown, not zero.
AMORE_PRICING_FILE=./config/pricing.json

# --- Budgets per run -----------------------------------------------------
AMORE_BUDGET_MAX_TOKENS=200000
AMORE_BUDGET_MAX_USD=2.00
AMORE_BUDGET_MAX_TOOL_STEPS=60
AMORE_BUDGET_MAX_SECONDS=1800
AMORE_WORKER_CONCURRENCY=1

# --- Tracker (optional private GitHub ledger of confirmed applications) ---
# Off: applications are recorded in the database only and the sync queue marks them not applicable.
# On: a local clone of your own private records repository (see docs/workflow-sources.md for the expected layout)
# receives one commit per confirmed application. Never point this at a repository you do not own.
AMORE_TRACKER_ENABLED=false
AMORE_TRACKER_REMOTE_URL=
AMORE_TRACKER_CLONE_DIR=./runtime/private/tracker
AMORE_TRACKER_REMOTE=origin
AMORE_TRACKER_BRANCH=main
AMORE_TRACKER_PUSH_ENABLED=false

# --- Browser -------------------------------------------------------------
AMORE_BROWSER_HEADLESS=true
AMORE_BROWSER_SESSION_DIR=./runtime/private/sessions
# Comma-separated hostnames the execution adapter may navigate to. Empty blocks all live navigation.
AMORE_BROWSER_ALLOWED_HOSTS=
# Extra hosts allowed for scripts/styles/fonts/frames on an allowed page (never navigation). The Greenhouse adapter adds
# its own CDN and reCAPTCHA hosts; list more here only if a board breaks without them.
AMORE_BROWSER_RESOURCE_HOSTS=
# Automatic captcha step for approved applications. Off = a human check pauses the application for you (default).
# On = simple text / image grid checks are sent to the AI model, at most N tries, all recorded. Some job sites forbid
# this; turning it on is your decision and your risk. The Settings switch overrides this default.
AMORE_CAPTCHA_AUTOSOLVE=false
AMORE_CAPTCHA_MAX_ATTEMPTS=3
# Sign in on a job site with a login you saved in 1Password. Off = a sign-in page stops the application for you (default).
# On = the application page asks you first; you press Allow 1Password on a dashboard that runs where the 1Password app
# and its command line tool (`op`) are installed, 1Password shows its own Touch ID or password window, and the login is
# handed to the browser task sealed to a one-time key. Nothing about the login is stored. A password the site refuses is
# never sent again by the app itself, no account is ever created, and nothing is submitted without your approval.
# The Settings switch overrides this default. ACCOUNT and VAULT narrow the search; empty searches everything you can read.
AMORE_SITE_SIGNIN=false
AMORE_SITE_SIGNIN_ACCOUNT=
AMORE_SITE_SIGNIN_VAULT=
# Create an account on a job site when 1Password has no login for it. Off = a site that needs an account stops the
# application for you (default). It needs AMORE_SITE_SIGNIN and its own approval for each site; an approval to apply
# never covers it. The login is saved in 1Password, with a password 1Password generates, before the form is sent.
# VAULT is the 1Password vault new logins are saved in; it must be set, the app never lets the tool pick one.
# EMAIL is the address accounts are registered with; empty means the email in your profile.
# PASSWORD_TRIES is how many generated passwords one account may have in all when a site refuses one for a rule (1 to 3).
# These are settings only until the application page offers the step (see docs/PROGRESS.md).
AMORE_SITE_ACCOUNT_CREATE=false
AMORE_SITE_ACCOUNT_VAULT=
AMORE_SITE_ACCOUNT_EMAIL=
AMORE_SITE_ACCOUNT_PASSWORD_TRIES=3
# Read the verification email a job site sends after a sign-up. Off = you type the code or open the link (default).
# Access is read-only and is connected by you, on the computer you sit at: `amore mail connect --client-file <path>`
# (`amore mail status`, `amore mail disconnect`). Only a code, or a link on the job site's own domain, leaves a
# message; nothing else is kept and no model reads mail. WAIT_SECONDS is how long a lookup waits for the mail (30 to 900).
# GRANT_STORE is where the grant is kept: 1password (one item in AMORE_SITE_ACCOUNT_VAULT, read at your press) or
# file (<private dir>/mail/grant.json, owner-only, left out of backups). The server never holds it.
AMORE_MAIL_VERIFICATION=false
AMORE_MAIL_WAIT_SECONDS=300
AMORE_MAIL_GRANT_STORE=1password
# When an attempt stops short of a confirmed success, keep what the page showed and everything it sent and received
# (picture, page source, every request with headers, bodies and cookies, console, a network archive and a trace) in
# that job's private artifact folder until the next attempt for the job. Nothing is masked, so it can hold a site
# password and session cookies. It is not backed up, not synced and never shown to a model. false = keep nothing.
AMORE_STOP_RECORD=true
AMORE_STOP_RECORD_TRACE=true
# After a human check, keep the browser page open this many minutes so Continue can resume it. 0 turns the hold off.
# The background job runner has one browser, so other jobs wait during a hold.
AMORE_HUMAN_CHECK_HOLD_MINUTES=30
# Localhost-only debug port while a hold is active, so a visible browser on the same Mac can attach. 0 disables it.
# On the NAS this port stays inside the container and cannot be opened from your Mac.
AMORE_HUMAN_CHECK_CDP_PORT=9222
# After a human check, wait this many minutes and try once more in a fresh browser before sending a notification.
# 0 sends the note immediately. Skipped while a hold is still open. If the first try already clicked submit, the later try only looks for a confirmation.
AMORE_CHALLENGE_RETRY_MINUTES=180

# --- Outreach email and owner notifications (optional) -------------------
# Password is never stored here. Put only an op:// reference in .env.references (see config/op.env.example).
AMORE_SMTP_HOST=
AMORE_SMTP_PORT=587
AMORE_SMTP_USER=
# AMORE_SMTP_USERNAME is the older name for the same login. AMORE_SMTP_USER wins when both are set.
AMORE_SMTP_FROM=
AMORE_NOTIFY_EMAIL_TO=
# Optional JSON webhook. Leave empty to skip it. Do not put a secret token in this file if you can avoid it.
AMORE_NOTIFY_WEBHOOK_URL=
# Link included in each note. PUBLISH_URL is a full origin (http://192.168.2.49:8790). Otherwise PUBLISH_HOST plus AMORE_PORT.
AMORE_PUBLISH_URL=
AMORE_PUBLISH_HOST=

# --- Scheduling ----------------------------------------------------------
# Times of day at which the worker checks the watched job boards by itself: comma separated 24 hour HH:MM in
# AMORE_TIMEZONE, for example 08:00,16:30. Empty means only when asked on the Jobs page.
AMORE_DISCOVERY_SCHEDULE=
AMORE_LANGSMITH_TRACING=false
