# Non-secret configuration. Copy to .env on the machine running the service.
# Secrets are injected at runtime (op run --env-file .env.references -- ...). Leave them blank here.

# --- MongoDB -------------------------------------------------------------
# NAS: the app joins the existing private database network and uses mongodb://mongodb:27017.
# Mac dev: compose profile dev-mongo publishes 127.0.0.1:27027.
AMORE_MONGODB_URI=mongodb://127.0.0.1:27027
AMORE_MONGODB_DATABASE=amorehiremepls
AMORE_MONGODB_USERNAME=
AMORE_MONGODB_PASSWORD=
AMORE_MONGODB_AUTH_SOURCE=admin

# --- Web -----------------------------------------------------------------
AMORE_BIND_HOST=127.0.0.1
AMORE_PORT=8790
# Dashboard sign-in password (>= 12 chars) and cookie signing secret (>= 32 chars). Store in 1Password.
AMORE_APP_PASSWORD=
AMORE_APP_SECRET=
AMORE_SECURE_COOKIES=false
AMORE_TIMEZONE=America/Toronto

# --- Storage -------------------------------------------------------------
# Artifacts (resumes, receipts, snapshots) and private profile files. Mounted volume in Docker.
AMORE_ARTIFACT_DIR=./runtime/artifacts
AMORE_PRIVATE_DIR=./runtime/private
AMORE_LOG_DIR=./runtime/logs

# --- AI providers (optional; without a key the app runs deterministic paths only) ---------
# Default provider is OpenAI. AMORE_MODEL may be a bare model name (uses AMORE_MODEL_PROVIDER) or
# fully qualified, e.g. anthropic:claude-... to use Anthropic for a run.
AMORE_MODEL_PROVIDER=openai
AMORE_MODEL=
# Keys are injected at runtime from 1Password (config/op.env.example); never store them here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Dated pricing file (USD per 1M tokens). Unknown models record cost as unknown, not zero.
AMORE_PRICING_FILE=./config/pricing.json

# --- Budgets per run -----------------------------------------------------
AMORE_BUDGET_MAX_TOKENS=200000
AMORE_BUDGET_MAX_USD=2.00
AMORE_BUDGET_MAX_TOOL_STEPS=60
AMORE_BUDGET_MAX_SECONDS=1800
AMORE_WORKER_CONCURRENCY=1

# --- Tracker (GitHub ledger) --------------------------------------------
# Local clone of christya95/job-application-records used by the sync coordinator. Never the repo itself.
AMORE_TRACKER_CLONE_DIR=./runtime/private/job-application-records
AMORE_TRACKER_REMOTE=origin
AMORE_TRACKER_BRANCH=main
AMORE_TRACKER_PUSH_ENABLED=false

# --- Browser -------------------------------------------------------------
AMORE_BROWSER_HEADLESS=true
AMORE_BROWSER_SESSION_DIR=./runtime/private/sessions
# Comma-separated hostnames the execution adapter may navigate to. Empty blocks all live navigation.
AMORE_BROWSER_ALLOWED_HOSTS=

# --- Outreach email channel (optional) -----------------------------------
AMORE_SMTP_HOST=
AMORE_SMTP_PORT=587
AMORE_SMTP_USERNAME=
AMORE_SMTP_PASSWORD=
AMORE_SMTP_FROM=

# --- Scheduling ----------------------------------------------------------
# Cron-like discovery schedule in America/Toronto; empty disables.
AMORE_DISCOVERY_SCHEDULE=
AMORE_LANGSMITH_TRACING=false
