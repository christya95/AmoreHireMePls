# 1Password secret references for AmoreHireMePls (vault: AmoreHireMePls).
# Copy to .env.references (gitignored). Values are resolved only inside the launched process:
#   Mac:  op run --env-file .env.references -- uv run amore web
#   Mac:  op run --env-file .env.references -- uv run amore worker
#   NAS:  OP_SERVICE_ACCOUNT_TOKEN="$(cat /volume1/docker/amorehiremepls/op_token)" \
#         op run --env-file .env.references -- docker compose up -d web worker
# Expected items/fields (create them in the AmoreHireMePls vault; names are case sensitive):
#   item "OpenAI API Key"        field credential   (API_CREDENTIAL)
#   item "Dashboard Password"    field password     (PASSWORD, >= 12 chars)
#   item "App Session Secret"    field credential   (API_CREDENTIAL, >= 32 random chars)
#   item "NAS MongoDB App User"  fields username, password  (LOGIN; readWrite on database amorehiremepls only)
#   item "SMTP"                  fields username, password  (LOGIN; optional, email outreach and owner notifications)
OPENAI_API_KEY=op://AmoreHireMePls/OpenAI API Key/credential
AMORE_APP_PASSWORD=op://AmoreHireMePls/Dashboard Password/password
AMORE_APP_SECRET=op://AmoreHireMePls/App Session Secret/credential
AMORE_MONGODB_USERNAME=op://AmoreHireMePls/NAS MongoDB App User/username
AMORE_MONGODB_PASSWORD=op://AmoreHireMePls/NAS MongoDB App User/password
# The app user authenticates against its own database; keep this with the two lines above.
AMORE_MONGODB_AUTH_SOURCE=amorehiremepls
# Optional. The password reference is the only place the mailbox password lives. Never put the password itself here.
# AMORE_SMTP_USER=op://AmoreHireMePls/SMTP/username
# AMORE_SMTP_PASSWORD=op://AmoreHireMePls/SMTP/password
